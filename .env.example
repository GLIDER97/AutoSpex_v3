# SERVER-ONLY secrets: read by the Vercel functions in api/. Set them in Vercel
# (Project Settings > Environment Variables) and in .env.local for `npm run dev`.
# Never prefix them with VITE_ or inline them into client code, and never commit
# a real key (.env.local is git-ignored).

# OpenRouter key (https://openrouter.ai/settings/keys) for every AI tool (api/ai.ts).
OPENROUTER_API_KEY=your_openrouter_key_here

# Google Maps Platform key restricted to "Places API (New)", for the mechanic and
# wrap shop search (api/places.ts). Optional: without it the pages show a Google
# Maps link instead of the shop list.
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Optional: other OpenRouter models (defaults: anthropic/claude-haiku-5.5 and
# black-forest-labs/flux-3-image-klein).
# AI_TEXT_MODEL=anthropic/claude-haiku-5.5
# AI_IMAGE_MODEL=black-forest-labs/flux-3-image-klein

# Neon Postgres connection string (Vercel adds it when the database is connected).
# Holds the daily usage counters (api/_usage.ts). Without it, deployed functions
# refuse paid calls; `npm run dev` counts in memory.
# DATABASE_URL=postgres://...

# Optional: daily limits (whole numbers; 0 turns the feature off). Defaults shown.
# AI_TEXT_DAILY_LIMIT=2000
# AI_TEXT_DAILY_LIMIT_PER_IP=100
# AI_IMAGE_DAILY_LIMIT=150
# AI_IMAGE_DAILY_LIMIT_PER_IP=15
# PLACES_DAILY_LIMIT=300
# PLACES_DAILY_LIMIT_PER_IP=30

# Optional: secret for hashing visitor IPs in the counters (defaults to DATABASE_URL).
# USAGE_HASH_SECRET=some-long-random-string

# Optional: BOTID_CHECK=off turns off the Vercel BotID check on /api/ai and /api/places.
# BOTID_CHECK=off

# Optional: extra sites allowed to call /api/*, comma-separated
# (the site's own host, www.myautospex.com and myautospex.com are always allowed).
# ALLOWED_ORIGINS=https://staging.example.com

# Google Sheets Lead Storage
# Get this URL by following the setup guide in google-sheets-integration/SETUP_GUIDE.md
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
