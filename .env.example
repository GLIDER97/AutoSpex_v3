# Google Gemini API key. SERVER-ONLY: read by the Vercel function api/gemini.ts.
# Set it in Vercel (Project Settings > Environment Variables) and in .env.local for
# `npm run dev`. Never prefix it with VITE_ or inline it into client code.
GEMINI_API_KEY=your_api_key_here

# Optional: extra sites allowed to call /api/gemini, comma-separated
# (the site's own host, www.myautospex.com and myautospex.com are always allowed).
# ALLOWED_ORIGINS=https://staging.example.com

# Google Sheets Lead Storage
# Get this URL by following the setup guide in google-sheets-integration/SETUP_GUIDE.md
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
