{
    "cleanUrls": true,
    "trailingSlash": false,
    "functions": {
        "api/ai.ts": {
            "maxDuration": 60
        },
        "api/places.ts": {
            "maxDuration": 15
        },
        "api/wrap-image.ts": {
            "maxDuration": 15
        },
        "api/wraps.ts": {
            "maxDuration": 15
        }
    },
    "redirects": [
        {
            "source": "/free-obd2-code-decoder-repair-costs",
            "destination": "/article/free-obd2-code-decoder-repair-costs",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/((?!embed/).*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors 'self'"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
                }
            ]
        },
        {
            "source": "/embed/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors *"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/images/wraps/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/images/wraps/v/:id/:file",
            "destination": "/api/wrap-image?id=:id&file=:file"
        }
    ]
}
